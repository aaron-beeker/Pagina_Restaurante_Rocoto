{
  "name": "pagina-restaurante-rocoto",
  "version": "1.0.0",
  "description": "Pagina web para Rocoto Restaurante Chifa",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,css,html,json}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html,json}\" \"*.{js,json,md}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.15",
    "firebase": "^10.7.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.1",
    "lit-html": "^3.3.2",
    "swiper": "^11.0.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.32",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.6"
  },
  "main": "postcss.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaron-beeker/Pagina_Restaurante_Rocoto.git"
  },
